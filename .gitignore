# job queue persistence (manifest.json + per-job logs) — runtime state
config/jobs/

# === GeoParquet ===
*.parquet

# === Scratch space ===
# Anything under local/ is a working file and is never part of a release.
local/

# === Editor and AI assistant rule files ===
# Generated locally per developer; not part of the project.
.cursor/
.windsurf/
.clinerules/
.opencode/
.github/copilot-instructions.md

# === Screen recording sources ===
# ScreenToGif project files. The exported GIF is committed, the editable
# project behind it is not.
*.stg

# osmium sparse_file_array index, written into the working directory by
# osmium export when a test runs it without an explicit index path.
sparse_file_array
